import PackingOptimality.Polytopes4
import PackingOptimality.FacetWidth

/-!
# Two 5-simplices in a 5-cube: edge `2√3/5` is optimal

**Theorem (`sx5inhc5_n02`).** Two regular 5-simplices of edge 1 fit in a 5-cube of edge `2√3/5 ≈ 0.6928`, and in
no smaller one.

**Lower bound.** The facet-width lemma. The 5-simplex of edge 1 has height `√(3/5)`, and every point of the
cube of edge `s` is within `s √5/2` of its centre, so `s ≥ 2√(3/5)/√5 = 2√3/5`.

**Construction.** The apex is the corner `(√3/5) 𝟙` of the cube and the base lies in the hyperplane `Σ xᵢ = 0`
through the centre. Its five vertices are the rows of the **Paley matrix** of order 5 divided by `√10`:
`M i j = χ(j - i)`, with `χ` the quadratic character mod 5 (`χ(1) = χ(4) = 1`, `χ(2) = χ(3) = -1`). Its rows have
four entries `±1`, sum zero, and pairwise inner product `-1`, so they form a regular simplex of edge 1 centred at 0,
and every coordinate is at most `1/√10 < √3/5` in absolute value. The point reflection is the second simplex,
on the other side of `Σ xᵢ = 0`.

The piece is written through its barycentric coordinates: `λ₀ = (√3/3) Σ yₖ` for the apex and
`λᵢ = 1/5 + (√10/5) ⟨Mᵢ, y⟩ - (√3/15) Σ yₖ` for the base vertices.

(Generated by `scripts/optimality/lean_gen/emit_simplex5.py`.)
-/

namespace PackingOptimality.Simplex5

open Set BallBound CentreGeneral FacetWidth
open scoped Pointwise RealInnerProductSpace

abbrev E5 := EuclideanSpace ℝ (Fin 5)

noncomputable def pt5 (a b c d e : ℝ) : E5 := WithLp.toLp 2 ![a, b, c, d, e]
@[simp] theorem pt5_0 (a b c d e : ℝ) : pt5 a b c d e 0 = a := by simp [pt5]
@[simp] theorem pt5_1 (a b c d e : ℝ) : pt5 a b c d e 1 = b := by simp [pt5]
@[simp] theorem pt5_2 (a b c d e : ℝ) : pt5 a b c d e 2 = c := by simp [pt5]
@[simp] theorem pt5_3 (a b c d e : ℝ) : pt5 a b c d e 3 = d := by simp [pt5]
@[simp] theorem pt5_4 (a b c d e : ℝ) : pt5 a b c d e 4 = e := by simp [pt5]

theorem r3_2 : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
theorem r10_2 : Real.sqrt 10 ^ 2 = 10 := Real.sq_sqrt (by norm_num)

/-- Normalise polynomials in `√3` and `√10`. -/
macro "rad5" : tactic => `(tactic| (
  try ring_nf
  repeat (simp only [r3_2, r10_2]; try ring_nf)))

/-- The vertices: the apex `(√3/5) 𝟙` and the Paley rows over `√10`. -/
noncomputable def vv : Fin 6 → E5 := ![
    pt5 (Real.sqrt 3 / 5) (Real.sqrt 3 / 5) (Real.sqrt 3 / 5) (Real.sqrt 3 / 5) (Real.sqrt 3 / 5),
    pt5 (Real.sqrt 10 / 10 * 0) (Real.sqrt 10 / 10 * 1) (Real.sqrt 10 / 10 * (-1)) (Real.sqrt 10 / 10 * (-1)) (Real.sqrt 10 / 10 * 1),
    pt5 (Real.sqrt 10 / 10 * 1) (Real.sqrt 10 / 10 * 0) (Real.sqrt 10 / 10 * 1) (Real.sqrt 10 / 10 * (-1)) (Real.sqrt 10 / 10 * (-1)),
    pt5 (Real.sqrt 10 / 10 * (-1)) (Real.sqrt 10 / 10 * 1) (Real.sqrt 10 / 10 * 0) (Real.sqrt 10 / 10 * 1) (Real.sqrt 10 / 10 * (-1)),
    pt5 (Real.sqrt 10 / 10 * (-1)) (Real.sqrt 10 / 10 * (-1)) (Real.sqrt 10 / 10 * 1) (Real.sqrt 10 / 10 * 0) (Real.sqrt 10 / 10 * 1),
    pt5 (Real.sqrt 10 / 10 * 1) (Real.sqrt 10 / 10 * (-1)) (Real.sqrt 10 / 10 * (-1)) (Real.sqrt 10 / 10 * 1) (Real.sqrt 10 / 10 * 0)]

/-- The facet normals (gradients of the barycentric coordinates). -/
noncomputable def aa : Fin 6 → E5 := ![
    pt5 (Real.sqrt 3 / 3) (Real.sqrt 3 / 3) (Real.sqrt 3 / 3) (Real.sqrt 3 / 3) (Real.sqrt 3 / 3),
    pt5 (Real.sqrt 10 / 5 * 0 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 1 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * (-1) - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * (-1) - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 1 - Real.sqrt 3 / 15),
    pt5 (Real.sqrt 10 / 5 * 1 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 0 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 1 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * (-1) - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * (-1) - Real.sqrt 3 / 15),
    pt5 (Real.sqrt 10 / 5 * (-1) - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 1 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 0 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 1 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * (-1) - Real.sqrt 3 / 15),
    pt5 (Real.sqrt 10 / 5 * (-1) - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * (-1) - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 1 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 0 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 1 - Real.sqrt 3 / 15),
    pt5 (Real.sqrt 10 / 5 * 1 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * (-1) - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * (-1) - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 1 - Real.sqrt 3 / 15) (Real.sqrt 10 / 5 * 0 - Real.sqrt 3 / 15)]

noncomputable def cc : Fin 6 → ℝ := ![0, 1 / 5, 1 / 5, 1 / 5, 1 / 5, 1 / 5]

/-- The regular 5-simplex of edge 1, placed with its apex at a corner of the cube of edge `2√3/5`. -/
noncomputable def simplex5 : Set E5 := {y | ∀ j, 0 ≤ cc j + ⟪aa j, y⟫}

theorem inner5 (u y : E5) : ⟪u, y⟫ = u 0 * y 0 + u 1 * y 1 + u 2 * y 2 + u 3 * y 3 + u 4 * y 4 := by
  rw [CentreGeneral.inner_sum, Fin.sum_univ_five]

theorem v_mem (j : Fin 6) : vv j ∈ simplex5 := by
  intro k
  rw [inner5]
  fin_cases j <;> fin_cases k <;> simp [vv, aa, cc] <;> rad5 <;> norm_num

theorem v_one (j : Fin 6) : 1 ≤ cc j + ⟪aa j, vv j⟫ := by
  rw [inner5]
  fin_cases j <;> simp [vv, aa, cc] <;> rad5 <;> norm_num

theorem norm_a (j : Fin 6) : ‖aa j‖ ^ 2 * (3 / 5) ≤ 1 := by
  rw [← real_inner_self_eq_norm_sq, inner5]
  fin_cases j <;> simp [aa] <;> rad5 <;> norm_num

theorem box_norm (x : E5) (hx : x ∈ boxC 5) : ‖x‖ ^ 2 ≤ 5 / 4 := by
  rw [norm_sq_sum, Fin.sum_univ_five]
  have h : ∀ i, x i ^ 2 ≤ 1 / 4 := fun i => by
    have := abs_le.mp (hx i); nlinarith
  linarith [h 0, h 1, h 2, h 3, h 4]

/-- **Centre lemma.** -/
theorem centre_sx5 (s : ℝ) (hs0 : 0 ≤ s) (hs : s < 2 * Real.sqrt 3 / 5) (g : E5 ≃ᵃⁱ[ℝ] E5)
    (hg : g '' simplex5 ⊆ s • boxC 5) : (0 : E5) ∈ interior (g '' simplex5) := by
  refine centre_of_facet_width cc aa vv rfl v_mem v_one norm_a box_norm hs0 ?_ g hg
  have h1 : s ^ 2 < (2 * Real.sqrt 3 / 5) ^ 2 := by nlinarith
  have h2 : (2 * Real.sqrt 3 / 5) ^ 2 = 12 / 25 := by rad5
  nlinarith

/-! ## The piece lies in the cube -/

theorem bary (y : E5) : ∑ j, (cc j + ⟪aa j, y⟫) • vv j = y := by
  ext k
  simp only [inner5, Fin.sum_univ_six, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
  fin_cases k <;> simp [vv, aa, cc] <;> rad5

theorem bary_sum (y : E5) : ∑ j, (cc j + ⟪aa j, y⟫) = 1 := by
  simp only [inner5, Fin.sum_univ_six]
  simp [aa, cc]; rad5

theorem simplex5_sub {S : Set E5} (hS : Convex ℝ S) (hv : ∀ j, vv j ∈ S) : simplex5 ⊆ S := by
  intro y hy
  rw [← bary y]
  exact hS.sum_mem (fun j _ => hy j) (bary_sum y) (fun j _ => hv j)

theorem s_pos : 0 < 2 * Real.sqrt 3 / 5 := by positivity

theorem small : Real.sqrt 10 / 10 ≤ Real.sqrt 3 / 5 := by
  have h : (Real.sqrt 10 / 10) ^ 2 ≤ (Real.sqrt 3 / 5) ^ 2 := by
    rw [div_pow, div_pow, r10_2, r3_2]; norm_num
  exact (pow_le_pow_iff_left₀ (by positivity) (by positivity) two_ne_zero).mp h

theorem v_box (j : Fin 6) : vv j ∈ (2 * Real.sqrt 3 / 5) • boxC 5 := by
  refine mem_smul_box_of_coord s_pos fun k => ?_
  have h := small
  have h3 : 0 ≤ Real.sqrt 3 := Real.sqrt_nonneg 3
  have h10 : 0 ≤ Real.sqrt 10 := Real.sqrt_nonneg 10
  rw [abs_le]
  fin_cases j <;> fin_cases k <;> simp [vv] <;> (try constructor) <;> linarith

theorem inside : simplex5 ⊆ (2 * Real.sqrt 3 / 5) • boxC 5 :=
  simplex5_sub ((convex_box).smul _) v_box
where
  convex_box : Convex ℝ (boxC 5) := by
    intro x hx y hy p q hp hq hpq i
    have hx' := abs_le.mp (hx i); have hy' := abs_le.mp (hy i)
    simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, abs_le]
    constructor <;> nlinarith

/-! ## Separation by `Σ xᵢ = 0` -/

noncomputable def sumL : E5 →L[ℝ] ℝ :=
  EuclideanSpace.proj 0 + EuclideanSpace.proj 1 + EuclideanSpace.proj 2 + EuclideanSpace.proj 3 +
    EuclideanSpace.proj 4

theorem sumL_apply (x : E5) : sumL x = x 0 + x 1 + x 2 + x 3 + x 4 := rfl

theorem sumL_surjective : Function.Surjective sumL :=
  fun t => ⟨EuclideanSpace.single 0 t, by simp [sumL_apply]⟩

theorem sum_nonneg {y : E5} (hy : y ∈ simplex5) : 0 ≤ sumL y := by
  have h := hy 0
  rw [inner5] at h
  simp [aa, cc] at h
  rw [sumL_apply]
  have h3 : 0 < Real.sqrt 3 := by positivity
  nlinarith

noncomputable def negE : E5 ≃ᵃⁱ[ℝ] E5 := (LinearIsometryEquiv.neg ℝ (E := E5)).toAffineIsometryEquiv

theorem neg_inside : negE '' simplex5 ⊆ (2 * Real.sqrt 3 / 5) • boxC 5 := by
  rintro _ ⟨y, hy, rfl⟩
  obtain ⟨x, hx, hxy⟩ := inside hy
  refine ⟨-x, fun i => by simpa using hx i, ?_⟩
  show (2 * Real.sqrt 3 / 5) • -x = -y
  rw [smul_neg]; exact congrArg Neg.neg hxy

theorem disj : Disjoint (interior (negE '' simplex5)) (interior ((AffineIsometryEquiv.refl ℝ E5) '' simplex5)) := by
  apply interior_disjoint_of_separated sumL sumL_surjective (c := 0)
  · rintro _ ⟨y, hy, rfl⟩
    simp only [Set.mem_preimage, Set.mem_Iic]
    show sumL (-y) ≤ 0
    rw [map_neg]; linarith [sum_nonneg hy]
  · rintro _ ⟨y, hy, rfl⟩
    exact sum_nonneg hy

noncomputable def sx5Packing : Packing simplex5 (boxC 5) (2 * Real.sqrt 3 / 5) 2 where
  g := ![AffineIsometryEquiv.refl ℝ E5, negE]
  inside := by
    intro i; fin_cases i
    · simpa using inside
    · exact neg_inside
  disjoint := by
    intro i j hij
    fin_cases i <;> fin_cases j
    · exact absurd rfl hij
    · exact disj.symm
    · exact disj
    · exact absurd rfl hij

end PackingOptimality.Simplex5

namespace PackingOptimality

open Simplex5 BallBound

/-- **Two 5-simplices in a 5-cube: edge `2√3/5` is optimal.** -/
theorem sx5inhc5_n02 : Nonempty (Packing simplex5 (boxC 5) (2 * Real.sqrt 3 / 5) 2) ∧
    ∀ s : ℝ, 0 ≤ s → Packing simplex5 (boxC 5) s 2 → 2 * Real.sqrt 3 / 5 ≤ s := by
  refine ⟨⟨sx5Packing⟩, fun s hs P => ?_⟩
  by_contra h
  push Not at h
  exact no_packing_two_of_common_point (0 : E5) (fun g hg => centre_sx5 s hs h g hg) le_rfl P

end PackingOptimality
