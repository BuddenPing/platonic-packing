import PackingOptimality.Patterns
import PackingOptimality.BallBound
import PackingOptimality.Prisms

/-!
# Exact lattice windows: rhombic dodecahedra and truncated cubes

Two families of catalogue records are finite windows of a lattice tiling, at an exact integer scale. Here each
family is proved once, for every window, through the Voronoi window theorem (`Patterns.lean`), and the windows
behind the catalogue's records are instantiated. The records carry clearance (scale `3.0000003`, `4.0000003`,
`5.0000004`); these packings are at the exact scales. With deletion (`Packing.restrict`) they also give every
smaller count at the same scale.

* **Rhombic dodecahedra.** `R = {|xᵢ| + |xⱼ| ≤ 1}` is the Voronoi cell of the FCC lattice
  `D₃ = {v ∈ ℤ³ : v₀ + v₁ + v₂ even}`. For `x ∈ R` and `v ∈ D₃`, `2⟨x, v⟩ ≤ ‖v‖²` (`rd_voronoi`: the support
  function of `R` is `max(‖v‖_∞, ‖v‖₁/2)`, and both are at most `‖v‖²/2` on `D₃ \ 0`). A window
  `{w ∈ D₃ : |2wᵢ + eᵢ| + |2wⱼ + eⱼ| ≤ M}` (offset `e/2`) packs in `(M/2 + 1) R` (`rdo_window`):
  19 pieces at scale 3, 44 at scale 4 (offset `(½, ½, ½)`), 93 at scale 5 (PingYou's FCC shell, FCC window and the
  93-piece record). The catalogue's canonical rhombic dodecahedron is `(3√2/4) R` (`Packing.smulBoth`).
* **Truncated cubes.** `T = {|xᵢ| ≤ a, |x₀| + |x₁| + |x₂| ≤ 2a + ½}`, `a = (1 + √2)/2`, is the unit-edge truncated
  cube (the catalogue's canonical one). It lies in the Voronoi cell `[-a, a]³` of `2a ℤ³`. The `4 × 4 × 4` grid
  of cells minus its 8 corners packs 56 copies in `4 T` (`tcu56`; PingYou's Cartesian shell, `56 = 4³ - 2³`).

(Generated by `scripts/patterns/emit_windows.py`.)
-/

namespace PackingOptimality.Windows

open Set BallBound
open scoped Pointwise RealInnerProductSpace

/-! ## Integer facts -/

theorem int_abs_le_sq (a : ℤ) : |a| ≤ a ^ 2 := by
  rcases (by omega : a ≤ -1 ∨ a = 0 ∨ 1 ≤ a) with h | h | h
  · rw [abs_of_neg (by omega)]; nlinarith
  · subst h; simp
  · rw [abs_of_pos (by omega)]; nlinarith

theorem one_le_sq_of_ne {b : ℤ} (h : b ≠ 0) : 1 ≤ b ^ 2 := by
  rcases (by omega : b ≤ -1 ∨ 1 ≤ b) with h | h <;> nlinarith

theorem int_two_abs_le (a b c : ℤ) (h : Even (a + b + c)) : 2 * |a| ≤ a ^ 2 + b ^ 2 + c ^ 2 := by
  have hb := sq_nonneg b; have hc := sq_nonneg c
  rw [Int.even_iff] at h
  rcases (by omega : a ≤ -2 ∨ a = -1 ∨ a = 0 ∨ a = 1 ∨ 2 ≤ a) with h1 | h1 | h1 | h1 | h1
  · rw [abs_of_neg (by omega)]; nlinarith
  · subst h1
    have : b ≠ 0 ∨ c ≠ 0 := by omega
    rcases this with h2 | h2 <;> have := one_le_sq_of_ne h2 <;> norm_num <;> nlinarith
  · subst h1; norm_num; positivity
  · subst h1
    have : b ≠ 0 ∨ c ≠ 0 := by omega
    rcases this with h2 | h2 <;> have := one_le_sq_of_ne h2 <;> norm_num <;> nlinarith
  · rw [abs_of_pos (by omega)]; nlinarith

/-- An LP bound: with `uᵢ ≥ 0`, `uᵢ + uⱼ ≤ 1`, the maximum of `Σ uᵢ wᵢ` is `max(maxᵢ wᵢ, Σ wᵢ/2)`. -/
theorem lp3 {u0 u1 u2 w0 w1 w2 Q : ℝ} (hu0 : 0 ≤ u0) (hu1 : 0 ≤ u1) (_hu2 : 0 ≤ u2) (h01 : u0 + u1 ≤ 1)
    (h02 : u0 + u2 ≤ 1) (h12 : u1 + u2 ≤ 1) (hw0 : 0 ≤ w0) (hw1 : 0 ≤ w1) (hw2 : 0 ≤ w2)
    (A0 : 2 * w0 ≤ Q) (A1 : 2 * w1 ≤ Q) (A2 : 2 * w2 ≤ Q) (B : w0 + w1 + w2 ≤ Q) :
    2 * (u0 * w0 + u1 * w1 + u2 * w2) ≤ Q := by
  by_cases c0 : w1 + w2 ≤ w0
  · nlinarith [mul_nonneg (by linarith : 0 ≤ 1 - u0 - u1) hw1, mul_nonneg (by linarith : 0 ≤ 1 - u0 - u2) hw2,
      mul_nonneg (by linarith : 0 ≤ 1 - u0) (by linarith : 0 ≤ w0 - w1 - w2)]
  by_cases c1 : w0 + w2 ≤ w1
  · nlinarith [mul_nonneg (by linarith : 0 ≤ 1 - u0 - u1) hw0, mul_nonneg (by linarith : 0 ≤ 1 - u1 - u2) hw2,
      mul_nonneg (by linarith : 0 ≤ 1 - u1) (by linarith : 0 ≤ w1 - w0 - w2)]
  by_cases c2 : w0 + w1 ≤ w2
  · nlinarith [mul_nonneg (by linarith : 0 ≤ 1 - u0 - u2) hw0, mul_nonneg (by linarith : 0 ≤ 1 - u1 - u2) hw1,
      mul_nonneg (by linarith : 0 ≤ 1 - u2) (by linarith : 0 ≤ w2 - w0 - w1)]
  push Not at c0 c1 c2
  nlinarith [mul_nonneg (by linarith : 0 ≤ w0 + w1 - w2) (by linarith : 0 ≤ 1 - u0 - u1),
    mul_nonneg (by linarith : 0 ≤ w0 - w1 + w2) (by linarith : 0 ≤ 1 - u0 - u2),
    mul_nonneg (by linarith : 0 ≤ -w0 + w1 + w2) (by linarith : 0 ≤ 1 - u1 - u2)]

theorem inner3 (u y : P3) : ⟪u, y⟫ = u 0 * y 0 + u 1 * y 1 + u 2 * y 2 := by
  rw [CentreGeneral.inner_sum, Fin.sum_univ_three]

theorem norm3 (u : P3) : ‖u‖ ^ 2 = u 0 ^ 2 + u 1 ^ 2 + u 2 ^ 2 := by
  rw [norm_sq_sum, Fin.sum_univ_three]

/-- From `2⟨y, d⟩ ≤ ‖d‖²` to the Voronoi inequality `‖y‖ ≤ ‖y - d‖`. -/
theorem vor_of_inner {y d : P3} (h : 2 * ⟪y, d⟫ ≤ ‖d‖ ^ 2) : ‖y‖ ≤ ‖y - d‖ := by
  rw [← sq_le_sq₀ (norm_nonneg _) (norm_nonneg _), norm_sub_sq_real]; linarith

/-! ## Rhombic dodecahedra: the FCC lattice -/

/-- The rhombic dodecahedron `{|xᵢ| + |xⱼ| ≤ 1}`, the Voronoi cell of `D₃`. -/
def R1 : Set P3 := {x | |x 0| + |x 1| ≤ 1 ∧ |x 0| + |x 2| ≤ 1 ∧ |x 1| + |x 2| ≤ 1}

theorem rd_voronoi {x : P3} (hx : x ∈ R1) (v : Fin 3 → ℤ) (hv : Even (v 0 + v 1 + v 2)) :
    2 * (x 0 * v 0 + x 1 * v 1 + x 2 * v 2) ≤ (v 0 : ℝ) ^ 2 + (v 1 : ℝ) ^ 2 + (v 2 : ℝ) ^ 2 := by
  obtain ⟨h01, h02, h12⟩ := hx
  have t : ∀ i, x i * v i ≤ |x i| * |(v i : ℝ)| := fun i => by rw [← abs_mul]; exact le_abs_self _
  have hv1 : Even (v 1 + v 0 + v 2) := by rwa [show v 1 + v 0 + v 2 = v 0 + v 1 + v 2 by ring]
  have hv2 : Even (v 2 + v 0 + v 1) := by rwa [show v 2 + v 0 + v 1 = v 0 + v 1 + v 2 by ring]
  have A0 : 2 * |(v 0 : ℝ)| ≤ (v 0 : ℝ) ^ 2 + (v 1 : ℝ) ^ 2 + (v 2 : ℝ) ^ 2 := by
    exact_mod_cast int_two_abs_le (v 0) (v 1) (v 2) hv
  have A1 : 2 * |(v 1 : ℝ)| ≤ (v 0 : ℝ) ^ 2 + (v 1 : ℝ) ^ 2 + (v 2 : ℝ) ^ 2 := by
    have := int_two_abs_le (v 1) (v 0) (v 2) hv1
    have h : 2 * |v 1| ≤ v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 := by linarith
    exact_mod_cast h
  have A2 : 2 * |(v 2 : ℝ)| ≤ (v 0 : ℝ) ^ 2 + (v 1 : ℝ) ^ 2 + (v 2 : ℝ) ^ 2 := by
    have := int_two_abs_le (v 2) (v 0) (v 1) hv2
    have h : 2 * |v 2| ≤ v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 := by linarith
    exact_mod_cast h
  have B : |(v 0 : ℝ)| + |(v 1 : ℝ)| + |(v 2 : ℝ)| ≤ (v 0 : ℝ) ^ 2 + (v 1 : ℝ) ^ 2 + (v 2 : ℝ) ^ 2 := by
    have h := add_le_add (add_le_add (int_abs_le_sq (v 0)) (int_abs_le_sq (v 1))) (int_abs_le_sq (v 2))
    exact_mod_cast h
  have := lp3 (abs_nonneg (x 0)) (abs_nonneg (x 1)) (abs_nonneg (x 2)) h01 h02 h12 (abs_nonneg _)
    (abs_nonneg _) (abs_nonneg _) A0 A1 A2 B
  linarith [t 0, t 1, t 2]

/-- The point with coordinates `(2wᵢ + eᵢ)/2`. -/
noncomputable def half (w e : Fin 3 → ℤ) : P3 :=
  pt (((2 * w 0 + e 0 : ℤ) : ℝ) / 2) (((2 * w 1 + e 1 : ℤ) : ℝ) / 2) (((2 * w 2 + e 2 : ℤ) : ℝ) / 2)

theorem half_sub (w w' e : Fin 3 → ℤ) (i : Fin 3) : (half w' e - half w e) i = ((w' i - w i : ℤ) : ℝ) := by
  fin_cases i <;> simp [half] <;> ring

theorem mem_smul_R1 {s : ℝ} (hs : 0 < s) {x : P3} (h : |x 0| + |x 1| ≤ s ∧ |x 0| + |x 2| ≤ s ∧ |x 1| + |x 2| ≤ s) :
    x ∈ s • R1 := by
  refine ⟨s⁻¹ • x, ?_, by simp [smul_smul, hs.ne']⟩
  simp only [R1, Set.mem_setOf_eq, PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hs)]
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨?_, ?_, ?_⟩ <;>
  · rw [← mul_add]
    calc s⁻¹ * _ ≤ s⁻¹ * s := mul_le_mul_of_nonneg_left (by assumption) (by positivity)
      _ = 1 := inv_mul_cancel₀ hs.ne'

/-- **FCC windows.** The translates of `R` by the points `(2wᵢ + eᵢ)/2`, `w ∈ D₃` distinct, with
`|2wᵢ + eᵢ| + |2wⱼ + eⱼ| ≤ M`, pack in `(M/2 + 1) R`. -/
noncomputable def rdo_window {n : ℕ} (W : Fin n → Fin 3 → ℤ) (e : Fin 3 → ℤ) (M : ℤ) (hM : 0 ≤ M)
    (hinj : Function.Injective W) (heven : ∀ k, Even (W k 0 + W k 1 + W k 2))
    (hwin : ∀ k, |2 * W k 0 + e 0| + |2 * W k 1 + e 1| ≤ M ∧ |2 * W k 0 + e 0| + |2 * W k 2 + e 2| ≤ M ∧
      |2 * W k 1 + e 1| + |2 * W k 2 + e 2| ≤ M) :
    Packing R1 R1 ((M : ℝ) / 2 + 1) n := by
  have key : ∀ k l, ∀ y ∈ R1, ‖y‖ ≤ ‖y - (half (W l) e - half (W k) e)‖ := by
    intro k l y hy
    apply vor_of_inner
    rw [inner3, norm3, half_sub, half_sub, half_sub]
    have hv : Even ((W l 0 - W k 0) + (W l 1 - W k 1) + (W l 2 - W k 2)) := by
      have := (heven l).sub (heven k)
      rwa [show W l 0 + W l 1 + W l 2 - (W k 0 + W k 1 + W k 2) =
        (W l 0 - W k 0) + (W l 1 - W k 1) + (W l 2 - W k 2) by ring] at this
    exact rd_voronoi hy (fun i => W l i - W k i) hv
  have hMr : (0 : ℝ) ≤ M := by exact_mod_cast hM
  refine voronoi_packing (fun k => AffineIsometryEquiv.constVAdd ℝ P3 (half (W k) e)) (fun k => half (W k) e)
    ?_ ?_ ?_
  · intro k l h
    apply hinj; funext i
    have h2 : ((W l i - W k i : ℤ) : ℝ) = 0 := by
      rw [← half_sub]; simp only at h; rw [h, sub_self]; rfl
    have := Int.cast_eq_zero.mp h2
    omega
  · rintro k l _ ⟨y, hy, rfl⟩
    show ‖half (W k) e + y - half (W k) e‖ ≤ ‖half (W k) e + y - half (W l) e‖
    rw [show half (W k) e + y - half (W k) e = y by abel,
      show half (W k) e + y - half (W l) e = y - (half (W l) e - half (W k) e) by abel]
    exact key k l y hy
  · rintro k _ ⟨y, hy, rfl⟩
    obtain ⟨y01, y02, y12⟩ := hy
    obtain ⟨w01, w02, w12⟩ := hwin k
    have c : ∀ i, |(half (W k) e) i| = |((2 * W k i + e i : ℤ) : ℝ)| / 2 := by
      intro i; fin_cases i <;> simp [half, abs_div]
    have w01' : |((2 * W k 0 + e 0 : ℤ) : ℝ)| + |((2 * W k 1 + e 1 : ℤ) : ℝ)| ≤ M := by exact_mod_cast w01
    have w02' : |((2 * W k 0 + e 0 : ℤ) : ℝ)| + |((2 * W k 2 + e 2 : ℤ) : ℝ)| ≤ M := by exact_mod_cast w02
    have w12' : |((2 * W k 1 + e 1 : ℤ) : ℝ)| + |((2 * W k 2 + e 2 : ℤ) : ℝ)| ≤ M := by exact_mod_cast w12
    have t : ∀ i, |(half (W k) e + y) i| ≤ |((2 * W k i + e i : ℤ) : ℝ)| / 2 + |y i| := fun i => by
      rw [PiLp.add_apply, ← c i]; exact abs_add_le _ _
    show half (W k) e + y ∈ ((M : ℝ) / 2 + 1) • R1
    refine mem_smul_R1 (by positivity) ⟨?_, ?_, ?_⟩
    · linarith [t 0, t 1]
    · linarith [t 0, t 2]
    · linarith [t 1, t 2]

/-! ## Truncated cubes: the cubic lattice -/

noncomputable def aT : ℝ := (1 + Real.sqrt 2) / 2

theorem aT_pos : 0 < aT := by unfold aT; positivity

theorem aT_le : aT ≤ 3 / 2 := by
  unfold aT
  have h := Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num); have := Real.sqrt_nonneg 2
  nlinarith

/-- The truncated cube of edge 1 (the catalogue's canonical one): octagon faces `|xᵢ| ≤ a`, triangle faces
`|x₀| + |x₁| + |x₂| ≤ 2a + ½`, `a = (1 + √2)/2`. -/
def T : Set P3 := {x | (|x 0| ≤ aT ∧ |x 1| ≤ aT ∧ |x 2| ≤ aT) ∧ |x 0| + |x 1| + |x 2| ≤ 2 * aT + 1 / 2}

/-- The centre `a (2w - 3)` of grid cell `w ∈ {0, 1, 2, 3}³`. -/
noncomputable def cc (w : Fin 3 → ℤ) : P3 :=
  pt (aT * ((2 * w 0 - 3 : ℤ) : ℝ)) (aT * ((2 * w 1 - 3 : ℤ) : ℝ)) (aT * ((2 * w 2 - 3 : ℤ) : ℝ))

theorem cc_sub (w w' : Fin 3 → ℤ) (i : Fin 3) : (cc w' - cc w) i = 2 * aT * ((w' i - w i : ℤ) : ℝ) := by
  fin_cases i <;> simp [cc] <;> ring

theorem mem_smul_T {s : ℝ} (hs : 0 < s) {x : P3}
    (h : (|x 0| ≤ s * aT ∧ |x 1| ≤ s * aT ∧ |x 2| ≤ s * aT) ∧ |x 0| + |x 1| + |x 2| ≤ s * (2 * aT + 1 / 2)) :
    x ∈ s • T := by
  refine ⟨s⁻¹ • x, ?_, by simp [smul_smul, hs.ne']⟩
  simp only [T, Set.mem_setOf_eq, PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hs)]
  obtain ⟨⟨h0, h1, h2⟩, h3⟩ := h
  have hi : 0 < s⁻¹ := inv_pos.mpr hs
  have e : ∀ b : ℝ, s⁻¹ * (s * b) = b := fun b => by field_simp
  refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
  · calc s⁻¹ * |x 0| ≤ s⁻¹ * (s * aT) := mul_le_mul_of_nonneg_left h0 hi.le
      _ = aT := e _
  · calc s⁻¹ * |x 1| ≤ s⁻¹ * (s * aT) := mul_le_mul_of_nonneg_left h1 hi.le
      _ = aT := e _
  · calc s⁻¹ * |x 2| ≤ s⁻¹ * (s * aT) := mul_le_mul_of_nonneg_left h2 hi.le
      _ = aT := e _
  · rw [← mul_add, ← mul_add]
    calc s⁻¹ * _ ≤ s⁻¹ * (s * (2 * aT + 1 / 2)) := mul_le_mul_of_nonneg_left h3 hi.le
      _ = _ := e _

/-- **Cubic windows of truncated cubes.** Distinct grid cells `w` with `|2wᵢ - 3| ≤ 3` and
`Σ |2wᵢ - 3| ≤ 7` (the `4 × 4 × 4` grid without its corners) pack in `4 T`. -/
noncomputable def tcu_window {n : ℕ} (W : Fin n → Fin 3 → ℤ) (hinj : Function.Injective W)
    (hwin : ∀ k, (|2 * W k 0 - 3| ≤ 3 ∧ |2 * W k 1 - 3| ≤ 3 ∧ |2 * W k 2 - 3| ≤ 3) ∧
      |2 * W k 0 - 3| + |2 * W k 1 - 3| + |2 * W k 2 - 3| ≤ 7) : Packing T T 4 n := by
  have ha := aT_pos; have ha2 := aT_le
  have key : ∀ k l, ∀ y ∈ T, ‖y‖ ≤ ‖y - (cc (W l) - cc (W k))‖ := by
    intro k l y hy
    obtain ⟨⟨h0, h1, h2⟩, -⟩ := hy
    apply vor_of_inner
    rw [inner3, norm3, cc_sub, cc_sub, cc_sub]
    set v0 : ℝ := ((W l 0 - W k 0 : ℤ) : ℝ); set v1 : ℝ := ((W l 1 - W k 1 : ℤ) : ℝ)
    set v2 : ℝ := ((W l 2 - W k 2 : ℤ) : ℝ)
    have q : ∀ z : ℤ, |(z : ℝ)| ≤ (z : ℝ) ^ 2 := fun z => by exact_mod_cast int_abs_le_sq z
    have b : ∀ (t u : ℝ), |t| ≤ aT → t * u ≤ aT * |u| := fun t u ht => by
      calc t * u ≤ |t * u| := le_abs_self _
        _ = |t| * |u| := abs_mul _ _
        _ ≤ aT * |u| := mul_le_mul_of_nonneg_right ht (abs_nonneg _)
    have s1 : y 0 * v0 + y 1 * v1 + y 2 * v2 ≤ aT * (v0 ^ 2 + v1 ^ 2 + v2 ^ 2) := by
      have := b _ v0 h0; have := b _ v1 h1; have := b _ v2 h2
      have := mul_le_mul_of_nonneg_left (q (W l 0 - W k 0)) ha.le
      have := mul_le_mul_of_nonneg_left (q (W l 1 - W k 1)) ha.le
      have := mul_le_mul_of_nonneg_left (q (W l 2 - W k 2)) ha.le
      nlinarith
    nlinarith [mul_le_mul_of_nonneg_left s1 (by positivity : (0 : ℝ) ≤ 4 * aT)]
  refine voronoi_packing (fun k => AffineIsometryEquiv.constVAdd ℝ P3 (cc (W k))) (fun k => cc (W k)) ?_ ?_ ?_
  · intro k l h
    apply hinj; funext i
    have h2 : 2 * aT * ((W l i - W k i : ℤ) : ℝ) = 0 := by
      rw [← cc_sub]; simp only at h; rw [h, sub_self]; rfl
    have h3 : ((W l i - W k i : ℤ) : ℝ) = 0 := by
      rcases mul_eq_zero.mp h2 with h4 | h4
      · exact absurd h4 (by positivity)
      · exact h4
    have := Int.cast_eq_zero.mp h3
    omega
  · rintro k l _ ⟨y, hy, rfl⟩
    show ‖cc (W k) + y - cc (W k)‖ ≤ ‖cc (W k) + y - cc (W l)‖
    rw [show cc (W k) + y - cc (W k) = y by abel,
      show cc (W k) + y - cc (W l) = y - (cc (W l) - cc (W k)) by abel]
    exact key k l y hy
  · rintro k _ ⟨y, hy, rfl⟩
    obtain ⟨⟨y0, y1, y2⟩, ys⟩ := hy
    obtain ⟨⟨w0, w1, w2⟩, ws⟩ := hwin k
    have c : ∀ i, |(cc (W k)) i| = aT * |((2 * W k i - 3 : ℤ) : ℝ)| := by
      intro i; fin_cases i <;> simp [cc, abs_mul, abs_of_pos ha]
    have w0' : |((2 * W k 0 - 3 : ℤ) : ℝ)| ≤ 3 := by exact_mod_cast w0
    have w1' : |((2 * W k 1 - 3 : ℤ) : ℝ)| ≤ 3 := by exact_mod_cast w1
    have w2' : |((2 * W k 2 - 3 : ℤ) : ℝ)| ≤ 3 := by exact_mod_cast w2
    have ws' : |((2 * W k 0 - 3 : ℤ) : ℝ)| + |((2 * W k 1 - 3 : ℤ) : ℝ)| + |((2 * W k 2 - 3 : ℤ) : ℝ)| ≤ 7 := by
      exact_mod_cast ws
    have t : ∀ i, |(cc (W k) + y) i| ≤ aT * |((2 * W k i - 3 : ℤ) : ℝ)| + |y i| := fun i => by
      rw [PiLp.add_apply, ← c i]; exact abs_add_le _ _
    have m0 := mul_le_mul_of_nonneg_left w0' ha.le
    have m1 := mul_le_mul_of_nonneg_left w1' ha.le
    have m2 := mul_le_mul_of_nonneg_left w2' ha.le
    have ms := mul_le_mul_of_nonneg_left ws' ha.le
    show cc (W k) + y ∈ (4 : ℝ) • T
    refine mem_smul_T (by norm_num) ⟨⟨?_, ?_, ?_⟩, ?_⟩
    · linarith [t 0]
    · linarith [t 1]
    · linarith [t 2]
    · linarith [t 0, t 1, t 2]

/-! ## The windows behind the catalogue -/

def W19 : Fin 19 → Fin 3 → ℤ := @@W19@@
def W44 : Fin 44 → Fin 3 → ℤ := @@W44@@
def W93 : Fin 93 → Fin 3 → ℤ := @@W93@@
def W56 : Fin 56 → Fin 3 → ℤ := @@W56@@

/-- An injective code for small integer vectors. -/
def code (w : Fin 3 → ℤ) : ℤ := (w 0 + 8) * 289 + (w 1 + 8) * 17 + (w 2 + 8)

theorem inj_of_code {n : ℕ} (W : Fin (n + 1) → Fin 3 → ℤ) (h : ∀ i : Fin n, code (W i.castSucc) < code (W i.succ)) :
    Function.Injective W :=
  Function.Injective.of_comp (f := code) (Fin.strictMono_iff_lt_succ.mpr h).injective

/-- **19 rhombic dodecahedra in a rhombic dodecahedron of scale 3** (the FCC shell: centre, 12 neighbours,
6 axial tips). -/
noncomputable def rdo19 : Packing R1 R1 3 19 := by
  have h := rdo_window W19 ![0, 0, 0] 4 (by norm_num) (inj_of_code W19 (by decide)) (by decide) (by decide)
  norm_num at h; exact h

/-- **44 rhombic dodecahedra at scale 4** (the FCC window with offset `(½, ½, ½)`). -/
noncomputable def rdo44 : Packing R1 R1 4 44 := by
  have h := rdo_window W44 ![1, 1, 1] 6 (by norm_num) (inj_of_code W44 (by decide)) (by decide) (by decide)
  norm_num at h; exact h

set_option maxRecDepth 20000 in
/-- **93 rhombic dodecahedra at scale 5.** -/
noncomputable def rdo93 : Packing R1 R1 5 93 := by
  have h := rdo_window W93 ![0, 0, 0] 8 (by norm_num) (inj_of_code W93 (by decide)) (by decide) (by decide)
  norm_num at h; exact h

/-- **56 truncated cubes in a truncated cube of edge 4** (the Cartesian shell `4³ - 2³`). -/
noncomputable def tcu56 : Packing T T 4 56 := tcu_window W56 (inj_of_code W56 (by decide)) (by decide)

/-- The catalogue's canonical rhombic dodecahedron (`src/solids.json`): `(3√2/4) R`. -/
noncomputable def rdoC : Set P3 := (3 * Real.sqrt 2 / 4) • R1

theorem rdoC_ne : (3 * Real.sqrt 2 / 4 : ℝ) ≠ 0 := by positivity

noncomputable def rdo19C : Packing rdoC rdoC 3 19 := rdo19.smulBoth _ rdoC_ne
noncomputable def rdo44C : Packing rdoC rdoC 4 44 := rdo44.smulBoth _ rdoC_ne
noncomputable def rdo93C : Packing rdoC rdoC 5 93 := rdo93.smulBoth _ rdoC_ne

end PackingOptimality.Windows

namespace PackingOptimality

open Windows

/-- **Lattice windows, with deletion.** For every `n ≤ 19`, `n` rhombic dodecahedra fit at scale 3; for
`n ≤ 44` at scale 4; for `n ≤ 93` at scale 5; and for `n ≤ 56`, `n` truncated cubes fit in a truncated cube of
edge 4. -/
theorem lattice_windows :
    (∀ n ≤ 19, Nonempty (Packing R1 R1 3 n)) ∧ (∀ n ≤ 44, Nonempty (Packing R1 R1 4 n)) ∧
    (∀ n ≤ 93, Nonempty (Packing R1 R1 5 n)) ∧ (∀ n ≤ 56, Nonempty (Packing T T 4 n)) :=
  ⟨fun _ h => ⟨rdo19.restrict h⟩, fun _ h => ⟨rdo44.restrict h⟩, fun _ h => ⟨rdo93.restrict h⟩,
    fun _ h => ⟨tcu56.restrict h⟩⟩

end PackingOptimality
